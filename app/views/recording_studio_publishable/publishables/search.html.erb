<% seo_title_max_characters = 60 %>

<%= render "job_nav" %>

<div class="flex w-full max-w-xl flex-col gap-6" data-publishable-character-count-template="<%= publishable_t("form.character_count", count: "__COUNT__", limit: "__LIMIT__") %>">
  <%= render FlatPack::PageTitle::Component.new(
    title: @job.title,
    subtitle: @job.subtitle,
    variant: :h1
  ) %>

  <%= form_with model: @publishable, url: publishable_path(recording_id: @parent_recording.id), method: :patch, class: "space-y-4", html: { novalidate: true } do |_form| %>
    <%= hidden_field_tag :section, @job.key %>

    <% if @seo_enabled != false %>
      <div class="space-y-1">
        <%= render FlatPack::TextInput::Component.new(
          name: "publishable[seo_title]",
          id: "publishable-seo-title-input",
          label: publishable_t("form.title"),
          value: @publishable.seo_title,
          maxlength: seo_title_max_characters,
          help_text: publishable_t("form.title_help"),
          data: { publishable_title_counter_input: true, publishable_title_counter_target: "seo-title", publishable_title_counter_limit: seo_title_max_characters }
        ) %>
        <p class="text-xs text-(--surface-muted-content-color)" data-publishable-title-counter="seo-title"></p>
      </div>
    <% end %>

    <%= render FlatPack::TextInput::Component.new(name: "publishable[slug]", label: publishable_t("form.slug"), value: @publishable.slug, required: true) %>

    <% if @seo_enabled != false %>
      <%= render FlatPack::TextArea::Component.new(
        name: "publishable[seo_description]",
        label: publishable_t("form.description"),
        value: @publishable.seo_description,
        rows: 4,
        character_count: true,
        max_characters: 160,
        placeholder: publishable_t("form.description_placeholder"),
        help_text: publishable_t("form.description_help")
      ) %>
    <% end %>

    <%= render FlatPack::Collapse::Component.new(
      id: "publishable-seo-advanced",
      title: publishable_t("form.advanced"),
      open: @publishable.canonical_url.present? || @publishable.noindex?
    ) do %>
      <div class="space-y-4">
        <%= hidden_field_tag "publishable[meta_robots]", "index,follow", id: "publishable_meta_robots_show" %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "publishable[meta_robots]",
          value: "noindex,follow",
          checked: @publishable.noindex?,
          label: publishable_t("form.noindex"),
          help_text: publishable_t("form.noindex_help")
        ) %>

        <%= render FlatPack::TextInput::Component.new(
          name: "publishable[canonical_url]",
          label: publishable_t("form.canonical_url"),
          value: @publishable.canonical_url,
          placeholder: publishable_t("form.canonical_placeholder"),
          help_text: publishable_t("form.canonical_help")
        ) %>
      </div>
    <% end %>

    <%= render FlatPack::Button::Component.new(text: publishable_t("form.save"), style: :primary, size: :md, type: "submit") %>
  <% end %>
</div>

<script>
  function initializePublishableTitleCounters() {
    document.querySelectorAll("[data-publishable-title-counter-input]").forEach(function(input) {
      if (input.dataset.publishableTitleCounterInitialized === "true") {
        return;
      }

      input.dataset.publishableTitleCounterInitialized = "true";

      var targetKey = input.dataset.publishableTitleCounterTarget;
      var limit = parseInt(input.dataset.publishableTitleCounterLimit || "0", 10);
      if (!targetKey || !limit) {
        return;
      }

      var counter = document.querySelector('[data-publishable-title-counter="' + targetKey + '"]');
      if (!counter) {
        return;
      }

      function updateCounter() {
        var host = input.closest("[data-publishable-character-count-template]");
        var template = (host && host.dataset.publishableCharacterCountTemplate) || "%{count} / %{limit} characters";
        counter.textContent = template.replace("__COUNT__", String(input.value || "").length).replace("__LIMIT__", String(limit));
      }

      input.addEventListener("input", updateCounter);
      input.addEventListener("change", updateCounter);
      updateCounter();
    });
  }

  document.addEventListener("DOMContentLoaded", initializePublishableTitleCounters);
  document.addEventListener("turbo:load", initializePublishableTitleCounters);
</script>
