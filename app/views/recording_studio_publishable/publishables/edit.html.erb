<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_text: "Back",
    back_icon: "chevron-left",
    back_href: main_app.root_path,
    items: []
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit publishable info",
    subtitle: "Manage SEO, scheduling, and public metadata against the parent recording.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render RecordingStudioPublishable::StatusBadge::Component.new(publishable: @publishable) %>
    <% if @parent_recording.publishable_public_path.present? %>
      <%= link_to(@parent_recording.publishable_public_path, class: "inline-flex") { render FlatPack::Button::Component.new(text: "Open public route", style: :secondary, size: :md) } %>
    <% end %>
  </div>

  <%= form_with model: @publishable, url: publishable_path(recording_id: @parent_recording.id), method: :patch, id: dom_id(@publishable, :edit), class: "space-y-4", multipart: true do |form| %>
    <%= render FlatPack::TextInput::Component.new(name: "publishable[slug]", label: "Slug", value: @publishable.slug, required: true) %>
    <div class="grid gap-4 md:grid-cols-2">
      <%= render FlatPack::TextInput::Component.new(name: "publishable[seo_title]", label: "SEO title", value: @publishable.seo_title) %>
      <%= render FlatPack::TextInput::Component.new(name: "publishable[canonical_url]", label: "Canonical URL", value: @publishable.canonical_url) %>
    </div>
    <div class="space-y-2">
      <label class="text-sm font-medium text-(--surface-content-color)" for="publishable_seo_description">SEO description</label>
      <%= form.text_area :seo_description, value: @publishable.seo_description, class: "min-h-28 w-full rounded-md border border-[var(--surface-border-color)] bg-[var(--surface-raised-background-color)] px-3 py-2 text-sm" %>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="space-y-2">
        <label class="text-sm font-medium text-(--surface-content-color)" for="publishable_status">Status</label>
        <%= form.select :status, RecordingStudioPublishable::Publishable.statuses.keys.map { |status| [status.humanize, status] }, {}, class: "w-full rounded-md border border-[var(--surface-border-color)] bg-[var(--surface-raised-background-color)] px-3 py-2 text-sm" %>
      </div>
      <%= render FlatPack::TextInput::Component.new(name: "publishable[meta_robots]", label: "Meta robots", value: @publishable.meta_robots, placeholder: "index,follow") %>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <%= render FlatPack::TextInput::Component.new(name: "publishable[publish_at]", label: "Publish at", value: @publishable.publish_at&.in_time_zone(@publishable.effective_time_zone)&.strftime("%Y-%m-%d %H:%M"), placeholder: "2026-05-13 09:00") %>
      <%= render FlatPack::TextInput::Component.new(name: "publishable[unpublish_at]", label: "Unpublish at", value: @publishable.unpublish_at&.in_time_zone(@publishable.effective_time_zone)&.strftime("%Y-%m-%d %H:%M"), placeholder: "2026-05-20 09:00") %>
      <div class="space-y-2">
        <label class="text-sm font-medium text-(--surface-content-color)" for="publishable_time_zone">Time zone</label>
        <%= form.select :time_zone, @time_zones, { include_blank: false }, class: "w-full rounded-md border border-[var(--surface-border-color)] bg-[var(--surface-raised-background-color)] px-3 py-2 text-sm" %>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <%= render FlatPack::TextInput::Component.new(name: "publishable[social_title]", label: "Social title", value: @publishable.social_title) %>
      <%= render FlatPack::TextInput::Component.new(name: "publishable[social_description]", label: "Social description", value: @publishable.social_description) %>
    </div>
    <div class="space-y-2">
      <label class="text-sm font-medium text-(--surface-content-color)" for="publishable_social_image_attachment_recording_id">Social image</label>
      <% if @publishable.social_image_supported? %>
        <% social_image_picker_items = Array(@social_image_attachments).filter_map do |attachment_recording| %>
          <% attachment = attachment_recording.recordable %>
          <% blob = attachment&.file_attachment&.blob %>
          <% next unless attachment.present? %>
          <% {
            id: attachment_recording.id,
            kind: :image,
            name: attachment.name.presence || blob&.filename&.to_s || "Image",
            title: attachment.name.presence || blob&.filename&.to_s || "Image",
            content_type: blob&.content_type,
            byte_size: blob&.byte_size,
            thumbnail_url: recording_studio_attachable.attachment_preview_file_path(attachment_recording, variant_name: :square_small),
            payload: { recording_id: attachment_recording.id }
          } %>
        <% end %>

        <% current_social_image_name = @publishable.social_image_attachment&.name %>
        <% current_social_image_preview_path = if @publishable.social_image_attached?
                                                 recording_studio_attachable.attachment_preview_file_path(@publishable.social_image_attachment_recording, variant_name: :square_small)
                                               end %>

        <div
          class="space-y-3"
          data-controller="social-image-picker"
          data-social-image-picker-picker-id-value="publishable-social-image-picker"
          data-action="flat-pack:picker:confirm@document->social-image-picker#handleConfirm"
        >
          <%= form.hidden_field :social_image_attachment_recording_id, data: { social_image_picker_target: "input" } %>

          <div
            class="flex items-center gap-3 rounded-md border border-(--surface-border-color) bg-(--surface-raised-background-color) p-3 <%= @publishable.social_image_attached? ? "" : "hidden" %>"
            data-social-image-picker-target="preview"
          >
            <%= image_tag(current_social_image_preview_path || "", alt: current_social_image_name || "Selected social image", class: "h-16 w-16 rounded-md object-cover", data: { social_image_picker_target: "previewImage" }) %>
            <div class="space-y-1 text-sm">
              <p class="font-medium text-(--surface-content-color)" data-social-image-picker-target="previewName"><%= current_social_image_name %></p>
              <p class="text-(--surface-muted-content-color)">Used for link previews and shared cards. Save changes to persist a new selection.</p>
            </div>
          </div>

          <p class="text-sm text-(--surface-muted-content-color) <%= @publishable.social_image_attached? ? "hidden" : "" %>" data-social-image-picker-target="emptyState">
            No social image selected yet. Choose one from the picker or upload a new image.
          </p>

          <div class="flex flex-wrap gap-2">
            <%= render FlatPack::Button::Component.new(
              text: social_image_picker_items.any? ? "Choose image" : "Upload an image first",
              style: :secondary,
              size: :md,
              type: "button",
              disabled: social_image_picker_items.empty?,
              icon: "image",
              data: {
                action: "click->flat-pack--modal#open",
                "modal-id": "publishable-social-image-picker"
              }
            ) %>
            <%= render FlatPack::Button::Component.new(
              text: "Clear selection",
              style: :ghost,
              size: :md,
              type: "button",
              class: (@publishable.social_image_attached? ? nil : "hidden"),
              data: {
                action: "social-image-picker#clear",
                social_image_picker_target: "clearButton"
              }
            ) %>
          </div>

          <% if social_image_picker_items.any? %>
            <%= render FlatPack::Picker::Component.new(
              id: "publishable-social-image-picker",
              title: "Select social image",
              subtitle: "Choose an image from the publishable attachment library.",
              items: social_image_picker_items,
              modal: true,
              accepted_kinds: [:image],
              selection_mode: :single,
              auto_confirm: true,
              search_mode: :local,
              results_layout: :grid,
              modal_body_height_mode: :fixed,
              modal_body_height: "clamp(18rem, 50vh, 26rem)",
              confirm_text: "Use image",
              context: { target: "publishable-social-image" }
            ) %>
          <% end %>
        </div>

        <div class="flex flex-wrap gap-2">
          <%= link_to(recording_studio_attachable.recording_attachment_upload_path(@publishable_recording, redirect_mode: :return_to, return_to: request.fullpath), class: "inline-flex") { render FlatPack::Button::Component.new(text: "Upload image", style: :secondary, size: :md, icon: "arrow-up-tray") } %>
          <%= link_to(recording_studio_attachable.recording_attachments_path(@publishable_recording, kind: :images), class: "inline-flex") { render FlatPack::Button::Component.new(text: "Manage library", style: :secondary, size: :md, icon: "photo") } %>
        </div>
        <p class="text-sm text-(--surface-muted-content-color)">Upload images into the publishable attachment library, then choose which one should appear when the page is shared.</p>
      <% else %>
        <p class="text-sm text-(--surface-muted-content-color)">Install Active Storage and Recording Studio Attachable in the host app to upload a social image.</p>
      <% end %>
    </div>
    <%= render FlatPack::Button::Component.new(text: "Save changes", style: :primary, size: :md, type: "submit") %>
  <% end %>
</div>
