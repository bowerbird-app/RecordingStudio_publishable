<% social_image_modal_id = "publishable-social-image-picker-modal" %>

<div
  class="mx-auto flex w-full max-w-6xl flex-col gap-6"
  data-controller="recording-studio-attachable--attachment-image-picker"
  data-recording-studio-attachable--attachment-image-picker-picker-url-value="<%= recording_studio_attachable.recording_attachment_picker_path(@publishable_recording) %>"
  data-recording-studio-attachable--attachment-image-picker-upload-url-value="<%= recording_studio_attachable.recording_attachment_imports_path(@publishable_recording) %>"
  data-recording-studio-attachable--attachment-image-picker-direct-upload-url-value="<%= main_app.rails_direct_uploads_path %>"
  data-recording-studio-attachable--attachment-image-picker-max-file-size-value="<%= RecordingStudioAttachable.configuration.max_file_size %>"
  data-recording-studio-attachable--attachment-image-picker-image-processing-enabled-value="<%= RecordingStudioAttachable.configuration.image_processing_enabled %>"
  data-recording-studio-attachable--attachment-image-picker-image-processing-max-width-value="<%= RecordingStudioAttachable.configuration.image_processing_max_width %>"
  data-recording-studio-attachable--attachment-image-picker-image-processing-max-height-value="<%= RecordingStudioAttachable.configuration.image_processing_max_height %>"
  data-recording-studio-attachable--attachment-image-picker-image-processing-quality-value="<%= RecordingStudioAttachable.configuration.image_processing_quality %>"
  data-recording-studio-attachable--attachment-image-picker-multiple-selection-value="false"
  data-recording-studio-attachable--attachment-image-picker-modal-id-value="<%= social_image_modal_id %>">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_text: "Back",
    back_href: main_app.root_path,
    items: []
  ) %>

  <% recordable = @parent_recording.recordable %>
  <% recordable_name = recordable.try(:title).presence || recordable.try(:name).presence || @parent_recording.recordable_type.to_s.demodulize.humanize %>
  <% pill_active_classes = FlatPack::Button::Pill::Component::ITEM_ACTIVE_CLASSES %>
  <% pill_inactive_classes = FlatPack::Button::Pill::Component::ITEM_INACTIVE_CLASSES %>
  <% published_state = @publishable.published_state? %>
  <% scheduled_for_future = @publishable.scheduled_for_future? %>
  <% normalized_meta_robots = @publishable.meta_robots.to_s.split(",").map { |token| token.strip.downcase }.reject(&:blank?).join(",") %>
  <% meta_robots_preset_options = [
       ["Default (index,follow)", "index,follow"],
       ["No index", "noindex,follow"],
       ["No index, no follow", "noindex,nofollow"],
       ["Index, no follow", "index,nofollow"],
       ["Custom", "__custom__"]
     ] %>
  <% meta_robots_preset_values = meta_robots_preset_options.to_h.values - ["__custom__"] %>
  <% meta_robots_initial_preset = meta_robots_preset_values.include?(normalized_meta_robots) ? normalized_meta_robots : "__custom__" %>
  <% seo_title_max_characters = 60 %>
  <% social_title_max_characters = 70 %>
  <% active_status_pill = if scheduled_for_future
                            "scheduled"
                          elsif published_state
                            "published"
                          else
                            "draft"
                          end %>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Publish",
      subtitle: recordable_name,
      variant: :h1
    ) %>
  </div>

  <%= form_with model: @publishable, url: publishable_path(recording_id: @parent_recording.id), method: :patch, id: dom_id(@publishable, :edit), class: "publishable-edit-form space-y-4", multipart: true, html: { novalidate: true }, data: { publishable_initial_mode: active_status_pill, publishable_pill_active_classes: pill_active_classes, publishable_pill_inactive_classes: pill_inactive_classes } do |form| %>
    <%= render FlatPack::Alert::Component.new(
      title: "You have unsaved changes",
      style: :warning,
      class: "hidden",
      data: { publishable_unsaved_warning: true }
    ) %>

    <div class="space-y-2">
      <%= form.hidden_field :status, value: (published_state ? "published" : "draft"), data: { publishable_status_field: true } %>
      <div class="flex flex-wrap items-center gap-2">
        <div data-publishable-status-pill-group>
          <%= render FlatPack::Button::Pill::Component.new(
            items: [
              {
                text: "Draft",
                href: "#",
                active: active_status_pill == "draft",
                data: { publishable_status_pill: "draft" },
                aria: { pressed: active_status_pill == "draft" }
              },
              {
                text: "Scheduled",
                href: "#",
                active: active_status_pill == "scheduled",
                data: { publishable_status_pill: "scheduled" },
                aria: { pressed: active_status_pill == "scheduled" }
              },
              {
                text: "Published",
                href: "#",
                active: active_status_pill == "published",
                data: { publishable_status_pill: "published" },
                aria: { pressed: active_status_pill == "published" }
              }
            ],
            aria: { label: "Publish status" }
          ) %>
        </div>
        <%= render FlatPack::Button::Component.new(
          icon: "cog-6-tooth",
          icon_only: true,
          style: :ghost,
          size: :sm,
          type: "button",
          data: { publishable_advanced_toggle: true },
          aria: { label: "Toggle publish settings", expanded: "false", controls: "publishable-advanced-panel" }
        ) %>
      </div>
    </div>

    <div class="<%= active_status_pill == "scheduled" ? "" : "hidden" %> grid gap-4 md:grid-cols-3" data-publishable-schedule-fields>
      <%= render FlatPack::DateTimeInput::Component.new(name: "publishable[publish_at]", label: "Publish at", value: @publishable.publish_at&.in_time_zone(@publishable.effective_time_zone), placeholder: "2026-05-13T09:00") %>
      <%= render FlatPack::DateTimeInput::Component.new(name: "publishable[unpublish_at]", label: "Unpublish at", value: @publishable.unpublish_at&.in_time_zone(@publishable.effective_time_zone), placeholder: "2026-05-20T09:00") %>
      <div class="space-y-2">
        <%= render FlatPack::Select::Component.new(
          name: "publishable[time_zone]",
          options: @time_zone_options,
          label: "Time zone",
          placeholder: "Select a time zone",
          value: @publishable.time_zone.presence
        ) %>
      </div>
    </div>

    <div id="publishable-advanced-panel" class="hidden space-y-8 bg-(--surface-raised-background-color)" data-publishable-advanced-panel>
      <section class="space-y-4">
        <h2 class="text-sm font-semibold text-(--surface-content-color)">SEO</h2>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="space-y-1">
            <%= render FlatPack::TextInput::Component.new(
              name: "publishable[seo_title]",
              id: "publishable-seo-title-input",
              label: "SEO title",
              value: @publishable.seo_title,
              maxlength: seo_title_max_characters,
              data: { publishable_title_counter_input: true, publishable_title_counter_target: "seo-title", publishable_title_counter_limit: seo_title_max_characters }
            ) %>
            <p class="text-xs text-(--surface-muted-content-color)" data-publishable-title-counter="seo-title"></p>
          </div>
          <%= render FlatPack::TextInput::Component.new(name: "publishable[canonical_url]", label: "Canonical URL", value: @publishable.canonical_url) %>
        </div>
        <%= render FlatPack::TextArea::Component.new(
          name: "publishable[seo_description]",
          label: "SEO description",
          value: @publishable.seo_description,
          rows: 4,
          character_count: true,
          max_characters: 160,
          placeholder: "Short summary for search engines"
        ) %>
        <%= form.hidden_field :meta_robots, value: (normalized_meta_robots.presence || "index,follow"), data: { publishable_meta_robots_value: true } %>
        <div class="space-y-2">
          <%= render FlatPack::Select::Component.new(
            name: "publishable_meta_robots_preset",
            options: meta_robots_preset_options,
            label: "Meta robots",
            value: meta_robots_initial_preset,
            data: { publishable_meta_robots_preset: true }
          ) %>
        </div>
        <div id="publishable-meta-robots-advanced" class="<%= meta_robots_initial_preset == "__custom__" ? "" : "hidden" %>" data-publishable-meta-robots-advanced>
          <%= render FlatPack::TextInput::Component.new(
            name: "publishable_meta_robots_custom",
            label: "Meta robots (advanced)",
            value: (normalized_meta_robots.presence || "index,follow"),
            placeholder: "index,follow",
            data: { publishable_meta_robots_custom_input: true }
          ) %>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-sm font-semibold text-(--surface-content-color)">Details</h2>
        <%= render FlatPack::TextInput::Component.new(name: "publishable[slug]", label: "Slug", value: @publishable.slug, required: true) %>
        <div class="space-y-4">
          <div class="space-y-1">
            <%= render FlatPack::TextInput::Component.new(
              name: "publishable[social_title]",
              id: "publishable-social-title-input",
              label: "Social title",
              value: @publishable.social_title,
              maxlength: social_title_max_characters,
              data: { publishable_title_counter_input: true, publishable_title_counter_target: "social-title", publishable_title_counter_limit: social_title_max_characters }
            ) %>
            <p class="text-xs text-(--surface-muted-content-color)" data-publishable-title-counter="social-title"></p>
          </div>
          <%= render FlatPack::TextArea::Component.new(
            name: "publishable[social_description]",
            label: "Social description",
            value: @publishable.social_description,
            rows: 4,
            character_count: true,
            max_characters: 200,
            placeholder: "Description shown in social previews"
          ) %>
        </div>
      </section>

      <% current_social_image_preview_path = if @publishable.social_image_attached? && @publishable.social_image_attachment&.file_attachment.present?
        main_app.rails_blob_path(@publishable.social_image_attachment.file_attachment, only_path: true)
      end %>

      <section class="space-y-4">
        <h2 class="text-sm font-semibold text-(--surface-content-color)">Image</h2>
        <div id="publishable-social-image-preview-wrapper" data-publishable-social-image-picker style="display: flex; flex-direction: column; align-items: flex-start; gap: 8px;">
          <%= form.hidden_field :social_image_attachment_recording_id, id: "publishable-social-image-input", data: { publishable_social_image_input: true } %>
          <img
            src="<%= current_social_image_preview_path || "" %>"
            alt="Social image"
            style="width: 192px; height: 192px; object-fit: cover; border-radius: 0.5rem; cursor: pointer; border: 1px solid var(--surface-border-color);"
            class="<%= @publishable.social_image_attached? ? "" : "hidden" %>"
            data-publishable-social-image-preview-image
            data-action="click->recording-studio-attachable--attachment-image-picker#openSinglePicker">
          <% unless @publishable.social_image_attached? %>
            <div
              style="width: 192px; height: 192px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border-radius: 0.5rem; border: 1px dashed var(--surface-border-color); background: var(--surface-raised-background-color); cursor: pointer;"
              data-publishable-social-image-empty
              data-action="click->recording-studio-attachable--attachment-image-picker#openSinglePicker">
              <span style="font-size: 0.875rem; color: var(--surface-muted-content-color);">Upload Photo</span>
            </div>
          <% end %>
        </div>
      </section>
    </div>

    <div class="publishable-save-actions pt-2">
      <%= form.submit "Save changes", id: "publishable-save-button", class: "inline-flex items-center justify-center gap-2 rounded-[var(--button-border-radius)] font-medium cursor-pointer transition-colors duration-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--button-focus-ring-color)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--button-focus-ring-offset-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm border border-[var(--button-secondary-border-color)] bg-[var(--button-secondary-background-color)] text-[var(--button-secondary-text-color)]", data: { publishable_save_button: true, publishable_save_primary_classes: "border-[var(--button-primary-border-color)] bg-[var(--button-primary-background-color)] hover:bg-[var(--button-primary-hover-background-color)] text-[var(--button-primary-text-color)] shadow-[var(--button-shadow)]", publishable_save_secondary_classes: "border-[var(--button-secondary-border-color)] bg-[var(--button-secondary-background-color)] text-[var(--button-secondary-text-color)]" } %>
    </div>
  <% end %>

  <%= render "recording_studio_attachable/attachment_image_pickers/modal",
    modal_id: social_image_modal_id,
    modal_title: "Select social image",
    recording: @publishable_recording,
    search_aria_label: "Search social images",
    empty_state_text: "No images found for this publishable yet." %>
</div>

<style>
  .publishable-edit-form .publishable-save-actions {
    position: relative;
    z-index: 1;
    pointer-events: auto;
  }

  .publishable-edit-form [data-publishable-social-image-preview-image]:not(.hidden) + [data-publishable-social-image-empty] {
    display: none !important;
  }

  [data-controller~="flat-pack--modal"][aria-hidden="true"] {
    pointer-events: none !important;
  }

</style>

<script>
  function applyClassTokens(element, classNames, shouldApply) {
    if (!element || !classNames) {
      return;
    }

    classNames.split(/\s+/).filter(Boolean).forEach(function(token) {
      element.classList.toggle(token, shouldApply);
    });
  }

  function initializePublishableTimeZoneDefault() {
    var select = document.querySelector('[name="publishable[time_zone]"]');
    if (!select || select.value) {
      return;
    }

    var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (!tz) {
      return;
    }

    var found = false;
    for (var i = 0; i < select.options.length; i++) {
      if (select.options[i].value === tz) {
        select.selectedIndex = i;
        found = true;
        break;
      }
    }

    if (found) {
      var event = new Event("change", { bubbles: true });
      select.dispatchEvent(event);
    }
  }

  function formatLocalDateTime(date) {
    var offsetDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
    return offsetDate.toISOString().slice(0, 16);
  }

  function setPublishableStatusMode(form, mode, options) {
    if (!(form instanceof HTMLFormElement) || !form.classList.contains("publishable-edit-form")) {
      return;
    }

    options = options || {};

    var statusField = form.querySelector('[data-publishable-status-field]');
    if (statusField) {
      statusField.value = mode;
    }

    var activeClasses = form.dataset.publishablePillActiveClasses || "";
    var inactiveClasses = form.dataset.publishablePillInactiveClasses || "";

    form.querySelectorAll("[data-publishable-status-pill]").forEach(function(pill) {
      var active = pill.getAttribute("data-publishable-status-pill") === mode;
      applyClassTokens(pill, activeClasses, active);
      applyClassTokens(pill, inactiveClasses, !active);
      pill.setAttribute("aria-pressed", active ? "true" : "false");
      if (active) {
        pill.setAttribute("aria-current", "page");
      } else {
        pill.removeAttribute("aria-current");
      }
    });

    var publishAtInput = form.querySelector('[name="publishable[publish_at]"]');
    var unpublishAtInput = form.querySelector('[name="publishable[unpublish_at]"]');
    var scheduleFields = form.querySelector("[data-publishable-schedule-fields]");

    if (scheduleFields) {
      scheduleFields.classList.toggle("hidden", mode !== "scheduled");
    }

    if (mode === "draft") {
      if (publishAtInput) publishAtInput.value = "";
      if (unpublishAtInput) unpublishAtInput.value = "";
    }

    if (mode === "published" && !options.preserveInputs) {
      // Keep published mode inputs empty unless user explicitly sets a schedule.
      if (publishAtInput) publishAtInput.value = "";
      if (unpublishAtInput) unpublishAtInput.value = "";
    }

    refreshPublishableDirtyState(form);
  }

  function publishableFormSnapshot(form) {
    var formData = new FormData(form);
    var entries = [];

    formData.forEach(function(value, key) {
      if (key === "authenticity_token") {
        return;
      }

      entries.push([key, String(value)]);
    });

    return JSON.stringify(entries);
  }

  function updatePublishableDirtyState(form, dirty) {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    var warning = form.querySelector("[data-publishable-unsaved-warning]");
    if (warning) {
      warning.classList.toggle("hidden", !dirty);
    }

    var saveButton = form.querySelector("[data-publishable-save-button]");
    if (!saveButton) {
      return;
    }

    var primaryClasses = saveButton.dataset.publishableSavePrimaryClasses || "";
    var secondaryClasses = saveButton.dataset.publishableSaveSecondaryClasses || "";

    applyClassTokens(saveButton, primaryClasses, dirty);
    applyClassTokens(saveButton, secondaryClasses, !dirty);
  }

  function refreshPublishableDirtyState(form) {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    var baseline = form.dataset.publishableInitialSnapshot || "";
    var dirty = publishableFormSnapshot(form) !== baseline;
    updatePublishableDirtyState(form, dirty);
  }

  function resetPublishableDirtyBaseline(form) {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    form.dataset.publishableInitialSnapshot = publishableFormSnapshot(form);
    updatePublishableDirtyState(form, false);
  }

  function initializePublishableDirtyTracking() {
    document.querySelectorAll("form.publishable-edit-form").forEach(function(form) {
      if (form.dataset.publishableDirtyTrackingInitialized === "true") {
        refreshPublishableDirtyState(form);
        return;
      }

      form.dataset.publishableDirtyTrackingInitialized = "true";

      form.addEventListener("input", function() {
        refreshPublishableDirtyState(form);
      });

      form.addEventListener("change", function() {
        refreshPublishableDirtyState(form);
      });

      resetPublishableDirtyBaseline(form);
    });
  }

  function initializePublishableMetaRobotsControls() {
    document.querySelectorAll("form.publishable-edit-form").forEach(function(form) {
      if (form.dataset.publishableMetaRobotsInitialized === "true") {
        return;
      }

      form.dataset.publishableMetaRobotsInitialized = "true";

      var hiddenValueInput = form.querySelector("[data-publishable-meta-robots-value]");
      var presetSelect = form.querySelector("[data-publishable-meta-robots-preset]");
      var advancedContainer = form.querySelector("[data-publishable-meta-robots-advanced]");
      var customInput = form.querySelector("[data-publishable-meta-robots-custom-input]");

      if (!hiddenValueInput || !presetSelect || !advancedContainer || !customInput) {
        return;
      }

      function setAdvancedVisible(visible) {
        advancedContainer.classList.toggle("hidden", !visible);
      }

      function normalizedValue(value) {
        return String(value || "")
          .split(",")
          .map(function(token) { return token.trim().toLowerCase(); })
          .filter(Boolean)
          .join(",");
      }

      function setHiddenValue(value) {
        hiddenValueInput.value = normalizedValue(value) || "index,follow";
      }

      function syncFromPreset() {
        var presetValue = presetSelect.value || "index,follow";
        var useCustom = presetValue === "__custom__";

        setAdvancedVisible(useCustom);

        if (useCustom) {
          setHiddenValue(customInput.value);
        } else {
          setHiddenValue(presetValue);
          customInput.value = presetValue;
        }

        refreshPublishableDirtyState(form);
      }

      presetSelect.addEventListener("change", syncFromPreset);

      customInput.addEventListener("input", function() {
        if (presetSelect.value === "__custom__") {
          setHiddenValue(customInput.value);
          refreshPublishableDirtyState(form);
        }
      });

      customInput.addEventListener("change", function() {
        if (presetSelect.value === "__custom__") {
          setHiddenValue(customInput.value);
          refreshPublishableDirtyState(form);
        }
      });

      syncFromPreset();
    });
  }

  function initializePublishableTitleCounters() {
    document.querySelectorAll("form.publishable-edit-form [data-publishable-title-counter-input]").forEach(function(input) {
      if (input.dataset.publishableTitleCounterInitialized === "true") {
        return;
      }

      input.dataset.publishableTitleCounterInitialized = "true";

      var targetKey = input.dataset.publishableTitleCounterTarget;
      var limit = parseInt(input.dataset.publishableTitleCounterLimit || "0", 10);
      if (!targetKey || !limit) {
        return;
      }

      var counter = document.querySelector('[data-publishable-title-counter="' + targetKey + '"]');
      if (!counter) {
        return;
      }

      function updateCounter() {
        var currentLength = String(input.value || "").length;
        counter.textContent = currentLength + " / " + limit + " characters";
      }

      input.addEventListener("input", updateCounter);
      input.addEventListener("change", updateCounter);
      updateCounter();
    });
  }

  function initializePublishableFormState() {
    document.querySelectorAll("form.publishable-edit-form").forEach(function(form) {
      var initialMode = form.dataset.publishableInitialMode || "draft";
      setPublishableStatusMode(form, initialMode, { preserveInputs: true });
    });
  }

  document.addEventListener("DOMContentLoaded", function() {
    initializePublishableTimeZoneDefault();
    initializePublishableFormState();
    initializePublishableMetaRobotsControls();
    initializePublishableTitleCounters();
    initializePublishableDirtyTracking();
  });

  document.addEventListener("turbo:load", function() {
    initializePublishableTimeZoneDefault();
    initializePublishableFormState();
    initializePublishableMetaRobotsControls();
    initializePublishableTitleCounters();
    initializePublishableDirtyTracking();
  });

  document.addEventListener("click", function(event) {
    var pill = event.target.closest("[data-publishable-status-pill]");
    if (pill) {
      event.preventDefault();

      var pillForm = pill.closest("form.publishable-edit-form");
      if (pillForm) {
        setPublishableStatusMode(pillForm, pill.getAttribute("data-publishable-status-pill"));
      }

      return;
    }

    var pillGroupLink = event.target.closest("[data-publishable-status-pill-group] a");
    if (pillGroupLink) {
      event.preventDefault();

      var fallbackForm = pillGroupLink.closest("form.publishable-edit-form");
      if (!fallbackForm) {
        return;
      }

      var explicitMode = pillGroupLink.getAttribute("data-publishable-status-pill");
      var labelMode = (pillGroupLink.textContent || "").trim().toLowerCase();
      var fallbackMode = explicitMode || labelMode;

      if (["draft", "scheduled", "published"].indexOf(fallbackMode) !== -1) {
        setPublishableStatusMode(fallbackForm, fallbackMode);
      }

      return;
    }

    var advancedToggleButton = event.target.closest("[data-publishable-advanced-toggle]");
    if (advancedToggleButton) {
      event.preventDefault();

      var advancedForm = advancedToggleButton.closest("form.publishable-edit-form");
      if (!advancedForm) {
        return;
      }

      var advancedPanel = advancedForm.querySelector("[data-publishable-advanced-panel]");
      if (!advancedPanel) {
        return;
      }

      var isHidden = advancedPanel.classList.contains("hidden");
      advancedPanel.classList.toggle("hidden", !isHidden);
      advancedToggleButton.setAttribute("aria-expanded", isHidden ? "true" : "false");
      return;
    }
  });

  document.addEventListener("recording-studio-attachable--attachment-image-picker:selected", function(event) {
    var host = document.querySelector("[data-publishable-social-image-picker]");
    if (!host) {
      return;
    }

    var attachment = event.detail && event.detail.attachment;
    if (!attachment) {
      return;
    }

    var input = host.querySelector("#publishable-social-image-input");
    if (input) {
      input.value = attachment.id || "";

      var form = input.closest("form.publishable-edit-form");
      if (form) {
        refreshPublishableDirtyState(form);
      }
    }

    var image = host.querySelector("[data-publishable-social-image-preview-image]");
    if (image) {
      image.src = attachment.thumbnail_url || "";
      image.classList.remove("hidden");
    }

    var emptyState = host.querySelector("[data-publishable-social-image-empty]");
    if (emptyState) {
      emptyState.classList.add("hidden");
    }

    var name = host.querySelector("[data-publishable-social-image-preview-name]");
    if (name) {
      name.textContent = attachment.name || "Selected image";
    }

    var copy = host.querySelector("[data-publishable-social-image-preview-copy]");
    if (copy) {
      copy.textContent = "Click to replace image.";
    }
  });
</script>
