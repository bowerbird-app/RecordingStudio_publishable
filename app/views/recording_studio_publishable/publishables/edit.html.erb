<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::Breadcrumb::Component.new(
    show_back: true,
    back_text: "Back",
    back_href: main_app.root_path,
    items: []
  ) %>

  <% recordable = @parent_recording.recordable %>
  <% recordable_name = recordable.try(:title).presence || recordable.try(:name).presence || @parent_recording.recordable_type.to_s.demodulize.humanize %>
  <% published_state = @publishable.published_state? %>
  <% publish_at_time = @publishable.publish_at&.in_time_zone(@publishable.effective_time_zone) %>
  <% timing_copy = if published_state
                     if publish_at_time.present? && publish_at_time > Time.current
                       "Scheduled to publish in #{distance_of_time_in_words(Time.current, publish_at_time)}"
                     elsif publish_at_time.present?
                       "Published #{time_ago_in_words(publish_at_time)} ago"
                     else
                       "Published just now"
                     end
                   end %>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Publish",
      subtitle: recordable_name,
      variant: :h1
    ) %>
  </div>

  <%= form_with model: @publishable, url: publishable_path(recording_id: @parent_recording.id), method: :patch, id: dom_id(@publishable, :edit), class: "publishable-edit-form space-y-4", multipart: true do |form| %>
    <div class="space-y-2">
      <%= hidden_field_tag "publishable[published_toggle]", "0" %>
      <%= render FlatPack::Switch::Component.new(
        name: "publishable[published_toggle]",
        label: (published_state ? "Published" : "Draft"),
        checked: published_state
      ) %>
      <p class="text-sm text-(--surface-muted-content-color) <%= timing_copy.present? ? "" : "hidden" %>" data-publishable-toggle-timing><%= timing_copy %></p>
    </div>

    <%= render FlatPack::Tabs::Component.new(default_tab: -1, variant: :pills) do |tabs| %>
      <% tabs.tab(id: "schedule", label: "Schedule") %>
      <% tabs.tab(id: "seo", label: "SEO") %>
      <% tabs.tab(id: "details", label: "Details") %>
      <% tabs.tab(id: "image", label: "Image") %>

      <% tabs.panel(id: "schedule") do %>
        <div class="grid gap-4 pt-4 md:grid-cols-3">
          <%= render FlatPack::DateTimeInput::Component.new(name: "publishable[publish_at]", label: "Publish at", value: @publishable.publish_at&.in_time_zone(@publishable.effective_time_zone), placeholder: "2026-05-13T09:00") %>
          <%= render FlatPack::DateTimeInput::Component.new(name: "publishable[unpublish_at]", label: "Unpublish at", value: @publishable.unpublish_at&.in_time_zone(@publishable.effective_time_zone), placeholder: "2026-05-20T09:00") %>
          <div class="space-y-2">
            <%= render FlatPack::Select::Component.new(
              name: "publishable[time_zone]",
              options: @time_zone_options,
              label: "Time zone",
              placeholder: "Select a time zone",
              required: true,
              value: @publishable.time_zone.presence
            ) %>
          </div>

          <script>
            document.addEventListener("DOMContentLoaded", function() {
              var select = document.querySelector('[name="publishable[time_zone]"]');
              if (!select) return;
              if (select.value) return; // already set
              var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
              if (!tz) return;
              // Try to match the detected timezone to an option value
              var found = false;
              for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value === tz) {
                  select.selectedIndex = i;
                  found = true;
                  break;
                }
              }
              if (found) {
                var event = new Event('change', { bubbles: true });
                select.dispatchEvent(event);
              }
            });
          </script>
        </div>
      <% end %>

      <% tabs.panel(id: "seo") do %>
        <div class="space-y-4 pt-4">
          <div class="grid gap-4 md:grid-cols-2">
            <%= render FlatPack::TextInput::Component.new(name: "publishable[seo_title]", label: "SEO title", value: @publishable.seo_title) %>
            <%= render FlatPack::TextInput::Component.new(name: "publishable[canonical_url]", label: "Canonical URL", value: @publishable.canonical_url) %>
          </div>
          <div class="space-y-2">
            <label class="text-sm font-medium text-(--surface-content-color)" for="publishable_seo_description">SEO description</label>
            <%= form.text_area :seo_description, value: @publishable.seo_description, class: "min-h-28 w-full rounded-md border border-[var(--surface-border-color)] bg-[var(--surface-raised-background-color)] px-3 py-2 text-sm" %>
          </div>
          <%= render FlatPack::TextInput::Component.new(name: "publishable[meta_robots]", label: "Meta robots", value: @publishable.meta_robots, placeholder: "index,follow") %>
        </div>
      <% end %>

      <% tabs.panel(id: "details") do %>
        <div class="space-y-4 pt-4">
          <%= render FlatPack::TextInput::Component.new(name: "publishable[slug]", label: "Slug", value: @publishable.slug, required: true) %>
          <div class="grid gap-4 md:grid-cols-2">
            <%= render FlatPack::TextInput::Component.new(name: "publishable[social_title]", label: "Social title", value: @publishable.social_title) %>
            <%= render FlatPack::TextInput::Component.new(name: "publishable[social_description]", label: "Social description", value: @publishable.social_description) %>
          </div>
        </div>
      <% end %>

      <% tabs.panel(id: "image") do %>
        <div class="space-y-2 pt-4">
          <label class="text-sm font-medium text-(--surface-content-color)" for="publishable_social_image_attachment_recording_id">Social image</label>
          <% if @publishable.social_image_supported? %>
            <% social_image_picker_items = Array(@social_image_attachments).filter_map do |attachment_recording| %>
              <% attachment = attachment_recording.recordable %>
              <% blob = attachment&.file_attachment&.blob %>
              <% next unless attachment.present? %>
              <% {
                id: attachment_recording.id,
                kind: :image,
                name: attachment.name.presence || blob&.filename&.to_s || "Image",
                title: attachment.name.presence || blob&.filename&.to_s || "Image",
                content_type: blob&.content_type,
                byte_size: blob&.byte_size,
                thumbnail_url: recording_studio_attachable.attachment_preview_file_path(attachment_recording, variant_name: :square_small),
                payload: { recording_id: attachment_recording.id }
              } %>
            <% end %>

            <% current_social_image_name = @publishable.social_image_attachment&.name %>
            <% current_social_image_preview_path = if @publishable.social_image_attached?
                                                     recording_studio_attachable.attachment_preview_file_path(@publishable.social_image_attachment_recording, variant_name: :square_small)
                                                   end %>

            <div
              class="space-y-3"
              data-controller="social-image-picker"
              data-social-image-picker-picker-id-value="publishable-social-image-picker"
              data-action="flat-pack:picker:confirm@document->social-image-picker#handleConfirm"
            >
              <%= form.hidden_field :social_image_attachment_recording_id, data: { social_image_picker_target: "input" } %>

              <div
                class="flex items-center gap-3 rounded-md border border-(--surface-border-color) bg-(--surface-raised-background-color) p-3 <%= @publishable.social_image_attached? ? "" : "hidden" %>"
                data-social-image-picker-target="preview"
              >
                <%= image_tag(current_social_image_preview_path || "", alt: current_social_image_name || "Selected social image", class: "h-16 w-16 rounded-md object-cover", data: { social_image_picker_target: "previewImage" }) %>
                <div class="space-y-1 text-sm">
                  <p class="font-medium text-(--surface-content-color)" data-social-image-picker-target="previewName"><%= current_social_image_name %></p>
                  <p class="text-(--surface-muted-content-color)">Used for link previews and shared cards. Save changes to persist a new selection.</p>
                </div>
              </div>

              <p class="text-sm text-(--surface-muted-content-color) <%= @publishable.social_image_attached? ? "hidden" : "" %>" data-social-image-picker-target="emptyState">
                No social image selected yet. Choose one from the picker or upload a new image.
              </p>

              <div class="flex flex-wrap gap-2">
                <%= render FlatPack::Button::Component.new(
                  text: social_image_picker_items.any? ? "Choose image" : "Upload an image first",
                  style: :secondary,
                  size: :md,
                  type: "button",
                  disabled: social_image_picker_items.empty?,
                  icon: "image",
                  data: {
                    action: "click->flat-pack--modal#open",
                    "modal-id": "publishable-social-image-picker"
                  }
                ) %>
                <%= render FlatPack::Button::Component.new(
                  text: "Clear selection",
                  style: :ghost,
                  size: :md,
                  type: "button",
                  class: (@publishable.social_image_attached? ? nil : "hidden"),
                  data: {
                    action: "social-image-picker#clear",
                    social_image_picker_target: "clearButton"
                  }
                ) %>
              </div>

              <% if social_image_picker_items.any? %>
                <%= render FlatPack::Picker::Component.new(
                  id: "publishable-social-image-picker",
                  title: "Select social image",
                  subtitle: "Choose an image from the publishable attachment library.",
                  items: social_image_picker_items,
                  modal: true,
                  accepted_kinds: [:image],
                  selection_mode: :single,
                  auto_confirm: true,
                  search_mode: :local,
                  results_layout: :grid,
                  modal_body_height_mode: :fixed,
                  modal_body_height: "clamp(18rem, 50vh, 26rem)",
                  confirm_text: "Use image",
                  context: { target: "publishable-social-image" }
                ) %>
              <% end %>
            </div>
            <div class="flex flex-wrap gap-2">
              <%= link_to(recording_studio_attachable.recording_attachment_upload_path(@publishable_recording, redirect_mode: :return_to, return_to: request.fullpath), class: "inline-flex") { render FlatPack::Button::Component.new(text: "Upload image", style: :secondary, size: :md, icon: "arrow-up-tray") } %>
              <%= link_to(recording_studio_attachable.recording_attachments_path(@publishable_recording, kind: :images), class: "inline-flex") { render FlatPack::Button::Component.new(text: "Manage library", style: :secondary, size: :md, icon: "photo") } %>
            </div>
            <p class="text-sm text-(--surface-muted-content-color)">Upload images into the publishable attachment library, then choose which one should appear when the page is shared.</p>
          <% else %>
            <p class="text-sm text-(--surface-muted-content-color)">Install Active Storage and Recording Studio Attachable in the host app to upload a social image.</p>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <div class="publishable-save-actions">
      <%= render FlatPack::Button::Component.new(text: "Save changes", style: :primary, size: :md, type: "submit") %>
    </div>
  <% end %>
</div>

<style>
  .publishable-edit-form input[name="publishable[published_toggle]"]:not(:checked) + [role="switch"] {
    background-color: var(--switch-track-background-color) !important;
  }

  .publishable-edit-form input[name="publishable[published_toggle]"]:checked + [role="switch"] {
    background-color: var(--switch-track-checked-background-color) !important;
  }

  .publishable-edit-form [role="tab"][aria-selected="false"] {
    border-color: var(--surface-border-color);
  }

  .publishable-edit-form .publishable-save-actions {
    display: none;
  }

  .publishable-edit-form:has([role="tab"][aria-selected="true"]) .publishable-save-actions {
    display: block;
  }
</style>

<script>
  document.addEventListener("change", function(event) {
    var toggle = event.target;
    if (!(toggle instanceof HTMLInputElement)) {
      return;
    }

    if (toggle.type !== "checkbox" || toggle.name !== "publishable[published_toggle]") {
      return;
    }

    if (toggle.form) {
      var form = toggle.form;
      var formData = new FormData(form);
      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      var labelElement = toggle.closest("label")?.nextElementSibling;
      var timingElement = form.querySelector("[data-publishable-toggle-timing]");

      fetch(form.action, {
        method: "PATCH",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "X-CSRF-Token": csrfToken || ""
        },
        credentials: "same-origin",
        body: formData
      }).then(function(response) {
        if (!response.ok) {
          throw new Error("Toggle save failed");
        }

        return response.json();
      }).then(function(payload) {
        if (labelElement) {
          labelElement.textContent = payload.status === "published" ? "Published" : "Draft";
        }

        var publishAtInput = form.querySelector('[name="publishable[publish_at]"]');
        if (publishAtInput && Object.prototype.hasOwnProperty.call(payload, "publish_at_input_value")) {
          publishAtInput.value = payload.publish_at_input_value || "";
        }

        var unpublishAtInput = form.querySelector('[name="publishable[unpublish_at]"]');
        if (unpublishAtInput && Object.prototype.hasOwnProperty.call(payload, "unpublish_at_input_value")) {
          unpublishAtInput.value = payload.unpublish_at_input_value || "";
        }

        var timeZoneInput = form.querySelector('[name="publishable[time_zone]"]');
        if (timeZoneInput && payload.time_zone) {
          timeZoneInput.value = payload.time_zone;
        }

        if (!timingElement) {
          return;
        }

        if (payload.timing_copy) {
          timingElement.textContent = payload.timing_copy;
          timingElement.classList.remove("hidden");
        } else {
          timingElement.textContent = "";
          timingElement.classList.add("hidden");
        }
      }).catch(function() {
        toggle.checked = !toggle.checked;
      });
    }
  });
</script>
