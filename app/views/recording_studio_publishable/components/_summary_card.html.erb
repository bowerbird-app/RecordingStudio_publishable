<% publishable = recording.current_publishable %>
<%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(title: publishable_t("summary.title"), subtitle: publishable_t("summary.subtitle"), variant: :h3, class: "mb-0 pb-0") %>
  <% end %>
  <% card.body do %>
    <% if publishable.present? %>
      <div class="space-y-3 text-sm leading-6">
        <p><strong><%= publishable_t("summary.slug") %>:</strong> <%= publishable.slug %></p>
        <p><strong><%= publishable_t("summary.canonical_path") %>:</strong> <%= recording.publishable_public_path %></p>
        <p><strong><%= publishable_t("summary.publish_window") %>:</strong> <%= [publishable.publish_at, publishable.unpublish_at].compact.map { |value| l(value, format: :long) rescue value }.join(" → ").presence || publishable_t("summary.always_available") %></p>
        <p><strong><%= publishable_t("summary.seo_title") %>:</strong> <%= publishable.seo_title.presence || publishable_t("summary.uses_parent_title") %></p>
      </div>
    <% else %>
      <p class="text-sm text-[var(--surface-muted-content-color)]"><%= publishable_t("summary.empty") %></p>
    <% end %>
  <% end %>
<% end %>
