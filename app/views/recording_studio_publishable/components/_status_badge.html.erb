<% style =
  if publishable.currently_published?
    :success
  elsif publishable.scheduled_for_future?
    :warning
  elsif publishable.unpublished?
    :error
  else
    :info
  end %>
<%= render FlatPack::Badge::Component.new(text: (publishable.currently_published? ? "Published" : publishable.status.humanize), style: style, size: :sm) %>
