<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Recording Studio Publishable" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" if respond_to?(:stylesheet_link_tag) %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
