<div id="<%= wrapper_id %>">
  <% if notice.present? %>
    <%= render FlatPack::Alert::Component.new(description: notice, style: :success, class: "mb-2") %>
  <% end %>
  <% if alert.present? %>
    <%= render FlatPack::Alert::Component.new(description: alert, style: :danger, class: "mb-2") %>
  <% end %>

  <%= render FlatPack::Button::Dropdown::Component.new(
    text: state_config[:trigger],
    style: state_config[:style],
    size: size,
    icon: state_config[:icon],
    placement: :bottom_right
  ) do |dropdown| %>
    <% state_config[:actions].each do |action_name| %>
      <% action = action_config(action_name) %>
      <% dropdown.menu_item(
        text: action[:text],
        icon: action[:icon],
        href: transition_url(action[:transition]),
        data: { turbo_method: :patch, turbo_stream: true }
      ) %>
    <% end %>
    <% dropdown.menu_divider %>
    <% dropdown.menu_item(
      text: "Publish settings",
      icon: "cog-6-tooth",
      href: edit_url
    ) %>
  <% end %>
</div>
