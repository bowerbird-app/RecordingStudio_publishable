<% content_for :title, publishable_document_title %>

<div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-12">
  <% resolved_public_path = @page.respond_to?(:published_url) ? @page.published_url : nil %>
  <% resolved_public_url = resolved_public_path.present? ? "#{request.protocol}#{request.host_with_port}#{resolved_public_path}" : nil %>

  <%= render FlatPack::PageTitle::Component.new(
    title: @page.title,
    subtitle: @publishable.seo_description.presence || "Rendered through the parent type's conventional public template.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render RecordingStudioPublishable::StatusBadge::Component.new(publishable: @publishable) %>
    <%= render FlatPack::Badge::Component.new(
      text: (@page.respond_to?(:indexable?) && @page.indexable?) ? "In search" : "Hidden from search",
      style: (@page.respond_to?(:indexable?) && @page.indexable?) ? :success : :default,
      size: :sm
    ) %>
    <%= render FlatPack::Badge::Component.new(text: @recording.id, style: :info, size: :sm) %>
  </div>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <div class="space-y-4 text-sm leading-7">
        <p><strong>Page title:</strong> <%= @page.title %></p>
        <p><strong>Public path:</strong> <%= resolved_public_path %></p>
        <p><strong>Public URL:</strong> <%= resolved_public_url %></p>
        <% if @publishable.canonical_url.present? %>
          <p><strong>Original URL for search:</strong> <%= @publishable.canonical_url %></p>
        <% end %>
        <p><strong>Search listing:</strong> <%= @publishable.noindex? ? "Hidden from search" : "In search" %></p>
      </div>
    <% end %>
  <% end %>
</div>