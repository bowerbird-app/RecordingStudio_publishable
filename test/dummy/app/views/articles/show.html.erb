<div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: @article.title,
    subtitle: @publishable.seo_description.presence || "Rendered through the article controller configured for published routes.",
    variant: :h1
  ) %>

  <% if user_signed_in? %>
    <div class="flex flex-wrap gap-2">
      <%= render RecordingStudioPublishable::EditButtonComponent.new(recording: @recording, label: "Edit") %>
    </div>
  <% end %>
</div>