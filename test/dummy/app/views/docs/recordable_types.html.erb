<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recordable types",
    subtitle: "The list below comes directly from RecordingStudio.configuration.recordable_types.",
    variant: :h1
  ) %>

  <% if RecordingStudio::RecordableTypesService.filtered_types.any? %>
    <% RecordingStudio::RecordableTypesService.filtered_types.each do |recordable_type| %>
      <li><%= recordable_type %></li>
    <% end %>
  <% else %>
    <p>No recordable types available.</p>
  <% end %>
</div>