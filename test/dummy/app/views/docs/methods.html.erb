<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Review the public methods, scopes, and helper entry points exposed by the addon.",
    variant: :h1
  ) %>

  <% @method_sections.each do |section| %>
    <%= render FlatPack::CodeBlock::Component.new(language: :ruby, code: section[:code]) %>
  <% end %>
</div>
