<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recordings tree",
    subtitle: "Active dummy-app recordings shown as a nested parent/child outline.",
    variant: :h1
  ) %>

  <% if @recording_tree.any? %>
    <div class="space-y-6">
      <% @recording_tree.each do |node| %>
        <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
          <% card.body do %>
            <%= render partial: "recording_tree_node", locals: { node: node, depth: 0 } %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <p class="text-sm text-(--surface-muted-content-color)">No active recordings found.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
