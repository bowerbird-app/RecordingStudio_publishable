<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Helpers",
    subtitle: "Document the view helpers your addon exposes.",
    variant: :h1
  ) %>

  <% @helper_sections.each do |section| %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: section[:title],
      subtitle: section[:subtitle]
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(language: :erb, code: section[:code]) %>
  <% end %>
</div>