<% dummy_page_nav(title: "Add page", back_url: root_path, back_label: "Home", close_url: root_path) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Add page",
  variant: :h1
) %>

<%= form_with url: dummy_pages_path, method: :post, class: "space-y-4" do %>
  <%= render FlatPack::TextInput::Component.new(
    name: "title",
    label: "Page name",
    value: @next_page_title,
    placeholder: "Enter a page name"
  ) %>

  <%= render FlatPack::Button::Component.new(text: "Create page", style: :primary, size: :md, type: "submit") %>
<% end %>
