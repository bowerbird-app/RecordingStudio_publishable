<%= publishable_head_tags %>
<% publishable_job_screen = controller.is_a?(RecordingStudioPublishable::PublishablesController) &&
     %w[schedule search social].include?(controller.action_name) %>
<% if user_signed_in? && !publishable_hides_host_chrome? && !publishable_job_screen && !content_for?(:page_nav_right) %>
  <% recording_studio_page_nav_right do %>
    <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
    <%= render FlatPack::Button::Component.new(
      text: "Sign out",
      style: :ghost,
      size: :md,
      href: main_app.destroy_user_session_path,
      data: { turbo_method: :delete }
    ) %>
  <% end %>
<% end %>
