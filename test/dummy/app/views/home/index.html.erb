<% dummy_page_nav(title: "Pages", back_url: root_path, close_url: root_path) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Pages",
  variant: :h1
) %>

<%= render FlatPack::Button::Component.new(
  text: "Add page",
  style: :primary,
  size: :md,
  href: new_dummy_page_path
) %>

<% if @publishable_parent_recordings.any? %>
  <%= render FlatPack::Table::Component.new(data: @publishable_parent_recordings) do |table| %>
    <% table.column(title: "Name", html: ->(recording) { recording.recordable.try(:title).presence || recording.recordable.to_s }) %>
    <% table.column(title: "Type", html: ->(recording) { recording.recordable_type.to_s.demodulize }) %>
    <% table.column(title: "Path", html: ->(recording) {
      public_path = recording.publishable_public_path
      if public_path.present?
        render FlatPack::Link::Component.new(href: public_path).with_content(public_path)
      else
        "Not live yet"
      end
    }) %>
    <% table.column(title: "Search", html: ->(recording) {
      recordable = recording.recordable
      public_path = recording.publishable_public_path
      if recordable.respond_to?(:indexable?) && recordable.indexable?
        render FlatPack::Badge::Component.new(text: "In search", style: :success, size: :sm)
      elsif public_path.present?
        render FlatPack::Badge::Component.new(text: "Hidden from search", style: :default, size: :sm)
      else
        render FlatPack::Badge::Component.new(text: "Not live", style: :default, size: :sm)
      end
    }) %>
    <% table.column(title: "Edit", html: ->(recording) {
      render FlatPack::Button::Component.new(
        text: "Edit",
        style: :secondary,
        size: :sm,
        href: recording_studio_publishable.edit_recording_publishable_path(recording_id: recording.id)
      )
    }) %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "Nothing here yet",
    description: "Add a page to get going.",
    icon: :inbox
  ) %>
<% end %>
