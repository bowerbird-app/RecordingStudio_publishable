<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Dummy publishables",
    subtitle: "Review seeded pages and articles, then jump straight to each publishable edit screen and public route.",
    variant: :h1
  ) %>

  <%= render FlatPack::Button::Component.new(
    text: "Add Page",
    style: :primary,
    size: :md,
    href: new_dummy_page_path
  ) %>

  <% if @publishable_parent_recordings.any? %>
    <%= render FlatPack::Table::Component.new(data: @publishable_parent_recordings) do |table| %>
      <% table.column(title: "Type") do |recording| %>
        <%= recording.recordable_type.to_s.demodulize %>
      <% end %>
      <% table.column(title: "Title") do |recording| %>
        <%= recording.recordable.try(:title).presence || recording.recordable.to_s %>
      <% end %>
      <% table.column(title: "Parent") do |recording| %>
        <%= recording.parent_recording&.recordable_type.to_s.demodulize.underscore.humanize.presence || "Root" %>
      <% end %>
      <% table.column(title: "Public path") do |recording| %>
        <% public_path = recording.publishable_public_path %>
        <% if public_path.present? %>
          <%= render FlatPack::Link::Component.new(href: public_path) { public_path } %>
        <% else %>
          Not published yet
        <% end %>
      <% end %>
      <% table.column(title: "Search") do |recording| %>
        <% recordable = recording.recordable %>
        <% public_path = recording.publishable_public_path %>
        <% if recordable.respond_to?(:indexable?) && recordable.indexable? %>
          <%= render FlatPack::Badge::Component.new(text: "In search", style: :success, size: :sm) %>
        <% elsif public_path.present? %>
          <%= render FlatPack::Badge::Component.new(text: "Hidden from search", style: :default, size: :sm) %>
        <% else %>
          <%= render FlatPack::Badge::Component.new(text: "Not live", style: :default, size: :sm) %>
        <% end %>
      <% end %>
      <% table.column(title: "Actions") do |recording| %>
        <%= render RecordingStudioPublishable::EditButtonComponent.new(recording: recording, label: "Edit", show_tooltip: true) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No pages yet",
      description: "Add a page, then try publishing it or keeping it as a draft.",
      icon: :inbox
    ) %>
  <% end %>
</div>
