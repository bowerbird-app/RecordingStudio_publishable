<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Dummy pages",
    subtitle: "Create a new page, review its recording, and jump straight to the publishable edit screen.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= link_to new_dummy_page_path, class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(text: "Add Page", style: :primary, size: :md) %>
    <% end %>
  </div>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <% if @page_recordings.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-(--surface-border-color) text-left text-sm">
            <thead>
              <tr class="text-(--surface-muted-content-color)">
                <th class="px-4 py-3 font-medium">Page</th>
                <th class="px-4 py-3 font-medium">Recording</th>
                <th class="px-4 py-3 font-medium">Parent</th>
                <th class="px-4 py-3 font-medium">Public path</th>
                <th class="px-4 py-3 font-medium">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-(--surface-border-color)">
              <% @page_recordings.each do |recording| %>
                <tr>
                  <td class="px-4 py-3 font-medium"><%= recording.recordable.title %></td>
                  <td class="px-4 py-3"><%= recording.id %></td>
                  <td class="px-4 py-3"><%= recording.parent_recording&.recordable_type.to_s.demodulize.underscore.humanize.presence || "Root" %></td>
                  <td class="px-4 py-3"><%= recording.publishable_public_path.presence || "Not published yet" %></td>
                  <td class="px-4 py-3">
                    <%= link_to recording_studio_publishable.edit_recording_publishable_path(recording_id: recording.id), class: "inline-flex" do %>
                      <%= render FlatPack::Button::Component.new(text: "Edit", style: :secondary, size: :sm) %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-(--surface-muted-content-color)">No pages exist yet. Click Add Page to create the first dummy page.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
