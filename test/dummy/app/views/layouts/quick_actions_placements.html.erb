<!DOCTYPE html>
<html <%= tag.attributes(dummy_document_attributes.merge(class: "min-h-full")) %>>
  <head>
    <title>Where it sits</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="m-0 min-h-screen bg-[var(--surface-page-background-color)] text-[var(--surface-content-color)]">
    <%= render FlatPack::SidebarLayout::Component.new(storage_key: "publishable-placements") do |layout| %>
      <% layout.top_nav do %>
        <%= render FlatPack::TopNav::Component.new do |nav| %>
          <% nav.center do %>
            <%= render QuickActionsPlacements::PhoneMenu.new(recording: @recording) %>
          <% end %>
          <% nav.right(always_display: true) do %>
            <%= render RecordingStudioPublishable::QuickActions::Component.new(recording: @recording, name: "page-nav", size: :sm) %>
          <% end %>
        <% end %>
      <% end %>

      <% layout.main do %>
        <div class="fp-layout-content">
          <div class="fp-layout-column">
            <%= yield %>
          </div>
        </div>
      <% end %>
    <% end %>
  </body>
</html>
